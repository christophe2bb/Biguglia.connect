    "@types/react-dom": "^18",
    "@types/uuid": "^10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^15.5.15",
    "pg": "^8.20.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  }
