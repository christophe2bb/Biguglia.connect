# ─────────────────────────────────────────────────────────────────────────────
# .env.local.example — Biguglia Connect
#
# USAGE :
#   cp .env.local.example .env.local
#   Remplissez chaque valeur puis lancez : npm run dev
#
# ⚠️  Ne jamais committer .env.local (déjà dans .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
# OBLIGATOIRE — l'app ne démarre pas sans ces trois variables.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# ── URL du site ───────────────────────────────────────────────────────────────
# En local :      http://localhost:3000
# En production : https://biguglia-connect.vercel.app (ou votre domaine custom)

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Upstash Redis — rate-limiting distribué ──────────────────────────────────
# Dashboard Upstash → votre base → REST API
# Optionnel en local : l'app bascule sur un rate-limiter en mémoire si absent.

UPSTASH_REDIS_REST_URL=https://<db-name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>

# ── Sentry — monitoring d'erreurs ────────────────────────────────────────────
# Dashboard Sentry → Settings → Projects → votre projet → Client Keys (DSN)
# Optionnel : si absent, Sentry est désactivé silencieusement.
#
# NEXT_PUBLIC_SENTRY_DSN  = DSN public (exposé au navigateur)
# SENTRY_DSN              = DSN serveur (fallback, non exposé)
# SENTRY_AUTH_TOKEN       = token pour l'upload des source maps au build
# SENTRY_ORG              = slug de l'organisation (ex: biguglia-connect)
# SENTRY_PROJECT          = slug du projet       (ex: biguglia-connect-nextjs)

NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project-id>
SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project-id>
SENTRY_AUTH_TOKEN=<sentry-auth-token>
SENTRY_ORG=biguglia-connect
SENTRY_PROJECT=biguglia-connect-nextjs

# ── Version de l'application (optionnel) ─────────────────────────────────────
# Injecté automatiquement par Vercel via VERCEL_GIT_COMMIT_SHA.
# En local, laissez vide ou mettez "dev".

NEXT_PUBLIC_APP_VERSION=dev
